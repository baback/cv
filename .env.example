# Azure OpenAI — image regeneration workflow
# Copy to .env and fill in your values (never commit .env).
AZURE_API_KEY=your-azure-openai-key
AZURE_RESOURCE_NAME=your-resource-name        # https://<resource>.openai.azure.com
AZURE_IMAGE_DEPLOYMENT=gpt-image-1            # your deployment name for the gpt-image model
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com   # optional override
